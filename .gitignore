# ============================================================
#  SelfMadeGuard VPN — .gitignore
#  Игнорируем всё, что генерируется инструментами и не является
#  исходным кодом. В репозитории должны оставаться только:
#  исходники, ресурсы, gradle-скрипты и gradle wrapper.
# ============================================================

# ---------- IDE / редакторы ----------
.idea/
*.iml
*.ipr
*.iws
out/
.vscode/
.fleet/
*.hprof

# ---------- Gradle / Android build ----------
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
.navigation/
local.properties

# артефакты сборки
*.apk
*.aab
*.ap_
*.dex
*.class
*.log

# ---------- Kotlin ----------
.kotlin/

# ---------- Python (demo-сервер) ----------
__pycache__/
tools/.selfmadeguard-*
# старые локальные файлы прежнего имени движка
tools/.guardwire-*
*.py[cod]
.venv/
venv/

# ---------- ОС ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ---------- Локальные заметки ----------
theory.md

# ---------- Секреты и подписи ----------
# ключи и пароли не должны попадать в git
*.jks
*.keystore
keystore.properties
signing.properties
